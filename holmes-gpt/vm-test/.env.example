# GPUStack (OpenAI-compatible), used by HolmesGPT (agent) and the SREGym judge.
# Reached through the SSH reverse tunnel on 127.0.0.1:8443 (see setup.md "Model access").
OPENAI_API_BASE=https://gpustack.apps.one2n.io:8443/v1
OPENAI_API_KEY=
MODEL=openai/gpt-oss-120b
JUDGE_MODEL=openai/gpt-oss-120b

HOLMES_IMAGE=us-central1-docker.pkg.dev/genuine-flight-317411/devel/holmes:latest
# Host network lets the container reach the tunnel on 127.0.0.1:8443.
HOLMES_NETWORK=host
HOLMES_EXTRA_HOSTS=gpustack.apps.one2n.io:127.0.0.1

SREGYM_DIR=../../../SREGym
KUBE_CONTEXT=kind-kind
PROFILE=full
