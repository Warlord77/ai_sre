# Copy to .env (git-ignored) and fill in ONE provider block. Then: make setup
#
# PROVIDER selects which block is used: selfhosted | claude | openrouter
PROVIDER=selfhosted

# --- selfhosted: any OpenAI-compatible endpoint (vLLM, GPUStack, Ollama, LiteLLM proxy) ---
# The server must parse tool calls (vLLM: --enable-auto-tool-choice --tool-call-parser <parser>).
OPENAI_API_BASE=https://gpustack.apps.one2n.io:8443/v1
OPENAI_API_KEY=
SELFHOSTED_MODEL=gpt-oss-120b
# Reaching the endpoint through an SSH tunnel on this machine? Map its hostname to the tunnel:
HOLMES_EXTRA_HOSTS=gpustack.apps.one2n.io:127.0.0.1

# --- claude: Anthropic API key (console.anthropic.com) ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# --- openrouter: OpenRouter API key (openrouter.ai/keys) ---
OPENROUTER_API_KEY=
# OpenRouter model slug; check openrouter.ai/models for the exact name.
OPENROUTER_MODEL=anthropic/claude-opus-5.5

# --- optional ---
# Judge model in LiteLLM form (default: same model as the agent), e.g. anthropic/claude-opus-5-5
JUDGE_MODEL=
# SREGym checkout and kube context
SREGYM_DIR=../../../../SREGym
KUBE_CONTEXT=kind-kind
# full | svelte (svelte drops components nothing reads; for small machines)
PROFILE=full
HOLMES_IMAGE=us-central1-docker.pkg.dev/genuine-flight-317411/devel/holmes:latest
HOLMES_MEMORY=1g
HOLMES_MAX_STEPS=60
WAIT_FOR_POD_READY_TIMEOUT=1800
