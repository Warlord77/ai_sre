# ── LLM provider ────────────────────────────────────────────────────────────
# Options: openrouter | anthropic | openai
LLM_PROVIDER=claude-code
# OpenRouter (recommended — supports Claude, GPT-4, Mistral, etc.)
OPENROUTER_API_KEY=sk-or-v1-<your-openrouter-key>
# ── Slack (optional — opensre posts investigation reports here) ───────────────
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXXXXXX/XXXXXXX/XXXXXX