HERMES_PROVIDER_NAME=deepseek
HERMES_PROVIDER_BASE_URL=https://api.deepseek.com/v1
HERMES_PROVIDER_API_KEY_ENV=DEEPSEEK_API_KEY
DEEPSEEK_API_KEY=sk-your-key-here
HERMES_MODEL=deepseek-v4-pro

# Claude Code auth -- set ONE
# OPTION A: long-lived OAuth token (recommended; uses Pro/Max subscription rates)
#   Generate on host: claude setup-token  (prints token to stdout, does NOT save)
#   Valid for ~1 year. Required for ralph loops / non-interactive use.
CLAUDE_CODE_OAUTH_TOKEN=

# OPTION B: Anthropic API key (uses API pricing)
#   Get from https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
